            <div class="img"><img src="https://images.pexels.com/photos/16747126/pexels-photo-16747126.jpeg" alt="Obraz - most Golden Gate"></div>
            <div class="img"><img src="https://images.pexels.com/photos/16747126/pexels-photo-16747126.jpeg" alt="Obraz - most Golden Gate"></div>
        </section>
        <footer class="footer">
            <div class="icons">
                <a href="#" class="icon"><i class="fa-brands fa-facebook"></i></a>
                <a href="#" class="icon"><i class="fa-brands fa-x-twitter"></i></a>
                <a href="#" class="icon"><i class="fa-brands fa-instagram"></i></a>
